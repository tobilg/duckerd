{
  "name": "duckerd",
  "version": "0.3.1",
  "description": "A CLI tool for generating ERD diagrams from DuckDB databases",
  "author": "TobiLG <tobilg@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobilg/duckerd.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tobilg/duckerd/issues"
  },
  "homepage": "https://github.com/tobilg/duckerd#readme",
  "bin": {
    "duckerd": "dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node --import tsx src/index.ts",
    "test": "node --import tsx --test src/lib/*.test.ts src/commands/*.test.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "duckdb",
    "erd",
    "diagram",
    "cli"
  ],
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^15.0.0",
    "pdfkit": "^0.20.2",
    "pele": "^1.10.0",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/svg-to-pdfkit": "^0.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
